# QuickNode devnet HTTPS URL. Leave blank to use clusterApiUrl('devnet').
NEXT_PUBLIC_QUICKNODE_DEVNET_URL=

# Public program id. Leave blank to use the deployed default in src/lib/config.ts.
NEXT_PUBLIC_PROGRAM_ID=

# Server-side relayer keypair path for click-tracking writes (DEVNET only).
# Generate with: solana-keygen new -o ~/.config/solana/pitchlink-relayer.json
# Fund with: solana airdrop 1 <relayer pubkey> --url devnet
RELAYER_KEYPAIR=
