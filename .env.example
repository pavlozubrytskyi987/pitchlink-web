# QuickNode / Solana RPC
# Browser (public by design — restrict in the QuickNode dashboard):
NEXT_PUBLIC_QUICKNODE_DEVNET_URL=
# Server-only (relayer + API routes). Preferred over the NEXT_PUBLIC_ var.
# Never expose this to the browser.
SOLANA_RPC_URL=

# Public program id. Blank = deployed default in src/lib/config.ts.
NEXT_PUBLIC_PROGRAM_ID=

# Relayer (server-only). Signs init_click_counter / increment_click.
# Prefer RELAYER_SECRET_KEY on Vercel (base58 OR JSON byte array).
# Locally you can keep using a keypair file via RELAYER_KEYPAIR.
RELAYER_SECRET_KEY=
RELAYER_KEYPAIR=

# Durable store for links + winner campaign configs (server-only).
# Required on Vercel — without it, serverless instances have no shared disk.
# Create a Blob store in the Vercel project, then pull the token:
#   vercel env pull
BLOB_READ_WRITE_TOKEN=

# Optional seed so a fresh deploy ships the legitimately-claimed demo
# campaign without a remint. JSON arrays matching TrackedLink / Campaign.
LINKS_SEED_JSON=
CAMPAIGNS_SEED_JSON=
