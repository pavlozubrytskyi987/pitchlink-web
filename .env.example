# Browser RPC (public by design; restrict in the QuickNode dashboard).
NEXT_PUBLIC_QUICKNODE_DEVNET_URL=

# Server-only RPC for the relayer and API routes. Prefer this over the public var.
SOLANA_RPC_URL=

# Public program id. Blank uses the deployed default in src/lib/config.ts.
NEXT_PUBLIC_PROGRAM_ID=

# Relayer (server-only). Signs init_click_counter / increment_click.
# On Vercel: RELAYER_SECRET_KEY (base58 or JSON byte array).
# Locally: RELAYER_KEYPAIR (path to a keypair JSON).
RELAYER_SECRET_KEY=
RELAYER_KEYPAIR=

# Durable store for links and campaign configs. Required on Vercel.
BLOB_READ_WRITE_TOKEN=

# Optional JSON seeds so a fresh deploy can ship a claimed demo campaign.
LINKS_SEED_JSON=
CAMPAIGNS_SEED_JSON=
